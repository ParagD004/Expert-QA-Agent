# Backend-specific .gitignore

# Environment variables - ALL .env files
.env
.env.*
!.env.example
!.env.template

# Specific environment files
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Python virtual environments
venv/
env/
.venv/
.env/
ENV/
env.bak/
venv.bak/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyo
*.pyd
.Python

# Build and distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Vector database files
vector_db/
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Jupyter Notebook
.ipynb_checkpoints

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# FastAPI specific
.pytest_cache/

# Temporary files
*.tmp
*.temp
tmp/
temp/